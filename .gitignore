# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
# 공식 개발도구 원본의 일부라 추적한다 / part of the official dev tool, keep it
!devtool/bots/dist/

# Virtual environments / 가상환경
.venv/
venv/
env/

# Tool caches / 도구 캐시
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Game credentials / API tokens - never commit these
# 게임 인증 정보와 API 토큰 - 절대 커밋하지 말 것
.env
.env.*
secrets.*
*.token

# Local arena output and match logs / 로컬 아레나 출력과 경기 로그
runs/
*.log

# Editors and OS / 에디터와 운영체제
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Claude Code personal settings / 개인 설정 (팀 공유는 .claude/settings.json)
.claude/settings.local.json
